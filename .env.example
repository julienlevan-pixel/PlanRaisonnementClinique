# Configure the Supabase transaction-pooler connection on the server only.
# On Netlify set DATABASE_URL; in Replit development SUPABASE_DATABASE_URL takes priority.
DATABASE_URL=postgresql://postgres.PROJECT:replace-me@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?sslmode=verify-full
# Legacy development binding, optional; do not define it as an empty value.
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT:replace-me@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?sslmode=verify-full
# Optional dedicated migration connection, used only by the migrate command:
# MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT:replace-me@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=verify-full
SESSION_SECRET=replace-with-a-long-random-value
APP_BASE_URL=https://example.netlify.app
ADMIN_INITIAL_USERNAME=admin-example
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
# Preview contexts are blocked unless explicitly configured with a separate test DB:
# PRC_DATABASE_ENV=test
# Optional idempotent fictitious demo initialization for an existing teacher:
# PRC_DEMO_OWNER_USERNAME=teacher-example
# Local development only, same-origin Vite proxy to the shared HTTP backend:
# PRC_DEV_API_TARGET=http://127.0.0.1:3001
# Official public PostgreSQL CA: full PEM text (multiline) in Netlify Functions,
# or a readable filesystem path for local scripts. Never use a private key.
# DATABASE_SSL_ROOT_CERT=/private/path/to/supabase-ca.crt
