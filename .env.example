# Configure the Supabase transaction-pooler connection on the server only.
# On Netlify set DATABASE_URL; in Replit development SUPABASE_DATABASE_URL takes priority.
DATABASE_URL=postgresql://prc_app:replace-me@db.example.supabase.co:6543/postgres?sslmode=require
SUPABASE_DATABASE_URL=postgresql://prc_app:replace-me@db.example.supabase.co:6543/postgres?sslmode=require
SESSION_SECRET=replace-with-a-long-random-value
APP_BASE_URL=https://example.netlify.app
ADMIN_INITIAL_USERNAME=admin-example
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
